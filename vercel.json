{
  "version": 2,
  "public": true,
  "framework": "laravel",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.5"
    }
  },
  "routes": [
    {
      "src": "/(css|js|images|fonts|favicon.ico)(.*)",
      "dest": "public/$1$2"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.php"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_KEY": "base64:2cFBzkJtebcFXZVkeBvSSeDi0n3B+7CktSZFi0gQFYo=",
    "APP_URL": "https://siakad-ai.vercel.app",
    "DB_CONNECTION": "sqlite",
    "DB_DATABASE": "/tmp/database.sqlite",
    "SESSION_DRIVER": "cookie",
    "CACHE_STORE": "array"
  },
  "installCommand": "composer install",
  "buildCommand": "php artisan migrate --force && npm run build"
}

